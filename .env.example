# Server-side ONLY — never prefix with NEXT_PUBLIC_, never commit real keys.
# BharatCode LLM (https://bharatcode.ai/build) — POST /chat/completions, model qwen-3.8-27b
BHARATCODE_API_KEY=
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=qwen-3.8-27b

# eCourtsIndia partner API (THIRD-PARTY, not govt) — optional.
# Without this key the app runs in "aggregate-statistics mode" with a clear banner.
# Get a key at https://ecourtsindia.com — format: eci_live_...
ECI_BASE_URL=https://webapi.ecourtsindia.com
ECI_KEY=

# data.gov.in API key (free at https://data.gov.in) — used for NJDG dataset lookups
DATA_GOV_API_KEY=
